{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 6,

  "modules-left": [
    "custom/sidebar",
    "hyprland/workspaces"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "custom/updates",
    "bluetooth",
    "custom/gpu",
    "custom/cpu",
    "memory",
    "network",
    "idle_inhibitor",
    "wireplumber",
    "tray"
  ],

  "custom/sidebar": {
    "format": "󱇊",
    "on-click": "ags request -i synapse RightSidebar",
    "tooltip": false
  },

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "persistent-workspaces": {
      "*": 5
    }
  },

  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },

  "custom/cpu": {
    "exec": "~/.config/waybar/scripts/cpu",
    "return-type": "json",
    "interval": 2,
    "tooltip": true,
    "on-click": "kitty --title btop sh -c 'btop; read'"
  },

  "memory": {
    "format": "󰍛 {}%",
    "interval": 2,
    "tooltip": true,
    "on-click": "kitty --title btop sh -c 'btop; read'"
  },

  "network": {
    "interface": "en*",
    "format-ethernet": "󰒍",
    "format-linked": "󰒍",
    "format-disconnected": "󰒏",
    "tooltip-format-ethernet": "{ifname}\n  {ipaddr}/{cidr}\n󰮁  {gwaddr}",
    "tooltip-format-disconnected": "No network"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-connected": "󰂱 {num_connections}",
    "format-off": "󰂲",
    "format-disabled": "",
    "tooltip-format": "Bluetooth on\nNo devices connected",
    "tooltip-format-connected": "{num_connections} connected\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "  {device_alias}",
    "tooltip-format-enumerate-connected-battery": "  {device_alias} ({device_battery_percentage}%)",
    "on-click": "blueman-manager"
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰒲"
    },
    "tooltip-format-activated": "Idle inhibitor active",
    "tooltip-format-deactivated": "Idle inhibitor off"
  },

  "custom/updates": {
    "exec": "~/.config/waybar/scripts/updates",
    "return-type": "json",
    "interval": 1800,
    "on-click": "kitty sh -c 'paru -Syu; echo; read -p \"Done — press Enter to close.\"'",
    "tooltip": true
  },

  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 {volume}%",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "tooltip-format": "Volume: {volume}%\nScroll to adjust\nClick to mute\nRight-click for mixer",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    "max-volume": 150
  },

  "custom/gpu": {
    "exec": "~/.config/waybar/scripts/gpu",
    "return-type": "json",
    "interval": 2,
    "tooltip": true,
    "on-click": "kitty --title btop sh -c 'btop; read'"
  },

  "tray": {
    "spacing": 8
  }
}
