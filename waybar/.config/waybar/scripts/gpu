#!/usr/bin/env bash

if ! command -v nvidia-smi >/dev/null 2>&1; then
  printf '{"text":"GPU N/A","tooltip":"nvidia-smi not found","class":"unavailable"}\n'
  exit 0
fi

stats="$(nvidia-smi --query-gpu=utilization.gpu,memory.used,memory.total,temperature.gpu --format=csv,noheader,nounits 2>/dev/null | head -n1)"

if [ -z "$stats" ]; then
  printf '{"text":"GPU N/A","tooltip":"Could not read NVIDIA GPU stats","class":"unavailable"}\n'
  exit 0
fi

util="$(echo "$stats" | awk -F', ' '{print $1}')"
mem_used="$(echo "$stats" | awk -F', ' '{print $2}')"
mem_total="$(echo "$stats" | awk -F', ' '{print $3}')"
temp="$(echo "$stats" | awk -F', ' '{print $4}')"

printf '{"text":"GPU %s%%","tooltip":"GPU: %s%%\\nVRAM: %s / %s MiB\\nTemp: %s°C","class":"normal"}\n' \
  "$util" "$util" "$mem_used" "$mem_total" "$temp"
